          {
            "id": "u3-l2-05",
            "es": "Ella es inteligente",
            "ko": "그녀는 똑똑해",
            "accept_es": [
              "Es inteligente"
            ],
            "note": "-e로 끝나는 형용사는 남녀 형태가 같습니다."
