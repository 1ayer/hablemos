            ],
            "note": "복수형 hermanos는 남녀가 섞인 형제자매도 뜻합니다."
          },
          {
            "id": "u3-l1-07",
            "es": "¿Tienes hermanos?",
            "ko": "너 형제 있어?",
            "accept_es": [
              "¿Tú tienes hermanos?"
            ]
          },
          {
            "id": "u3-l1-08",
            "es": "Mis padres son de Sevilla",
            "ko": "우리 부모님은 세비야 출신이야",
