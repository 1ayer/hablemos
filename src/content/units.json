          {
            "id": "u3-l2-07",
            "es": "Estoy contento",
            "ko": "나 기뻐 (남성)",
            "accept_es": [
              "Yo estoy contento"
            ],
            "note": "estar는 지금의 상태, ser는 늘 그런 성질을 말합니다. 여성은 contenta."
          },
          {
            "id": "u3-l2-08",
            "es": "Estoy contenta",
            "ko": "나 기뻐 (여성)",
            "accept_es": [
